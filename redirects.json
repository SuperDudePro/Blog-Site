{
  "canonicalOrigin": "https://ourolddad.com",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ourolddad.com"
        }
      ],
      "destination": "https://ourolddad.com/:path*",
      "permanent": true,
      "note": "Canonicalize the retired www host."
    },
    {
      "source": "/search/label/Music Playlists",
      "destination": "/section/music-playlists",
      "permanent": true,
      "note": "Retired Blogger Music Playlists label appears in Bing search; preserve the matching current category."
    }
  ]
}
