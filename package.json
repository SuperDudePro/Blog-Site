{
  "name": "our-old-dad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate:post-metadata && vite",
    "create:post": "node scripts/create-post.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:routes": "node scripts/generate-route-pages.mjs",
    "generate:deployment": "node scripts/write-deployment-marker.mjs",
    "generate:post-metadata": "node scripts/generate-post-metadata.mjs",
    "sync:redirects": "node scripts/sync-redirects.mjs",
    "validate:redirects": "node scripts/validate-redirects.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "test:post-contract": "node --test test/post-contract.test.mjs",
    "retrofit:next": "node scripts/retrofit-next.mjs",
    "test:post-loading": "node --test test/post-loading.test.mjs",
    "test:indexnow": "node --test test/indexnow-selection.test.mjs",
    "test:seo-fields": "node --test test/seo-fields.test.mjs",
    "test:seo-only": "node --test test/seo-only-change.test.mjs",
    "test:inbound-webhook": "node --test test/inbound-webhook.test.mjs",
    "validate:post-contract": "node scripts/validate-post-contract.mjs --enforce",
    "validate:bundle-size": "node scripts/validate-bundle-size.mjs",
    "build": "npm run validate:redirects && npm run validate:sitemap && npm run generate:rss && npm run generate:llms && npm run generate:deployment && npm run generate:post-metadata && npm run validate:content && npm run test:post-contract && npm run test:post-loading && npm run test:indexnow && npm run test:seo-fields && npm run test:seo-only && npm run test:inbound-webhook && npm run validate:post-contract && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && npm run test:raster-art-transport && npm run test:playlist-directory && npm run generate:section-webps && vite build && npm run validate:bundle-size && npm run generate:routes && npm run validate:site && npm run validate:discovery",
    "preview": "vite preview",
    "validate:sitemap": "node scripts/validate-discovery.mjs https://ourolddad.com --sitemap scripts/generate-sitemap.mjs",
    "validate:discovery": "node scripts/validate-discovery.mjs https://ourolddad.com --built",
    "audit:quality": "node scripts/quality-audit.mjs --check",
    "baseline:quality": "node scripts/quality-audit.mjs --record",
    "test:raster-art-transport": "node --test test/raster-art-transport.test.mjs",
    "test:playlist-directory": "node --test test/playlist-directory.test.mjs",
    "generate:section-webps": "node scripts/generate-section-webps.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  }
}
