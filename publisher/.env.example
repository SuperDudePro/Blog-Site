# A long random password used by the Wilbert Publisher login screen.
PUBLISHER_ACCESS_KEY=

# Fine-grained GitHub personal access token restricted to both registered sites:
# SuperDudePro/Blog-Site and SuperDudePro/LifeEducationOrg.
# Required permissions: Contents read/write, Pull requests read/write,
# Actions read, Commit statuses read, Deployments read, Metadata read.
# Deployments read is how the status check finds the preview that Vercel
# recorded for a commit. A public repository serves those records to any
# token; on a private one, previews stay unverified without it.
GITHUB_TOKEN=

# Optional Vercel "Protection Bypass for Automation" secret for the site
# projects, so the status check can read protected previews. It is sent only
# to the preview deployment that Vercel's GitHub App recorded for the pull
# request's head commit, never to a URL taken from a comment or a redirect.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional comma-separated repository allowlist. Defaults to the registered profiles.
PUBLISHER_REPOSITORIES=SuperDudePro/Blog-Site,SuperDudePro/LifeEducationOrg
