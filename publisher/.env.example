# A long random password used by the Wilbert Publisher login screen.
PUBLISHER_ACCESS_KEY=

# Fine-grained GitHub personal access token restricted to SuperDudePro/Blog-Site.
# Required permissions: Contents read/write, Pull requests read/write,
# Actions read, Commit statuses read, Issues read, Metadata read.
GITHUB_TOKEN=

# Vercel AI Gateway key used only by the private Image Studio serverless functions.
AI_GATEWAY_API_KEY=

# Optional model overrides.
STUDIO_TEXT_MODEL=openai/gpt-5.4
STUDIO_IMAGE_MODEL=openai/gpt-image-2

# Optional. Defaults to SuperDudePro/Blog-Site.
PUBLISHER_REPOSITORY=SuperDudePro/Blog-Site
